{
  "schemaVersion": "1.0",
  "severityOrder": ["none", "patch", "minor", "major"],
  "runtimeOrder": ["none", "targeted-smoke", "full-clean-world"],
  "rules": [
    {"id":"canonical-source","patterns":["sources/**"],"minimumVersionBump":"minor","runtimeQualification":"full-clean-world","gates":["source","references","competencies","assets","regressions","compile","runtime-package"]},
    {"id":"generated-foundry-source","patterns":["src/packs/**"],"minimumVersionBump":"patch","runtimeQualification":"targeted-smoke","gates":["source","references","competencies","assets","regressions","compile","runtime-package"],"derivedSource":true},
    {"id":"assets","patterns":["assets/**"],"minimumVersionBump":"patch","runtimeQualification":"targeted-smoke","gates":["assets","regressions","runtime-package"]},
    {"id":"runtime-code","patterns":["scripts/**"],"minimumVersionBump":"patch","runtimeQualification":"full-clean-world","gates":["competencies","regressions","compile","runtime-package"]},
    {"id":"build-tooling","patterns":["tools/**",".github/workflows/**","package.json"],"minimumVersionBump":"patch","runtimeQualification":"targeted-smoke","gates":["source","references","competencies","assets","regressions","compile","runtime-package"]},
    {"id":"module-contract","patterns":["module.json","DEPLOYMENT-CONTRACT.md"],"minimumVersionBump":"major","runtimeQualification":"full-clean-world","gates":["source","references","competencies","assets","regressions","compile","runtime-package"]},
    {"id":"maintenance-policy","patterns":["maintenance/**","MAINTENANCE-WORKFLOW.md"],"minimumVersionBump":"none","runtimeQualification":"none","gates":["regressions"]},
    {"id":"release-control","patterns":["release-control/**","RELEASE-NOTES-*.md"],"minimumVersionBump":"none","runtimeQualification":"none","gates":[]},
    {"id":"documentation","patterns":["README.md","STEP-*-HANDOFF.md","RUNTIME-QUALIFICATION.md","ASSET-STAGING.md","build/**"],"minimumVersionBump":"none","runtimeQualification":"none","gates":[]}
  ],
  "derivedSourcePolicy": {
    "path": "src/packs/**",
    "rule": "Direct hand-editing is not a durable maintenance path. A src/packs change must be generated by the accepted source/build pipeline or accompanied by an explicit generator/compatibility change.",
    "authorizedCompanionPatterns": ["sources/**","tools/build-source-packs.py","tools/resolve-source-references.py","tools/rewrite-asset-paths.py","tools/repair-actor-embedded-keys.py"]
  }
}
