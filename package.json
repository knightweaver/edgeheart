{
  "name": "edgeheart",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for the Edgeheart Foundry VTT module.",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate-skeleton.mjs",
    "clean:packs": "rimraf packs",
    "compile:packs": "node tools/compile-packs.mjs",
    "extract:packs": "node tools/extract-packs.mjs",
    "build": "npm run validate && npm run clean:packs && npm run compile:packs",
    "build:sources": "python tools/build-source-packs.py",
    "validate:sources": "python tools/validate-source-packs.py",
    "resolve:references": "python tools/resolve-source-references.py",
    "validate:references": "python tools/validate-resolved-references.py",
    "validate:competencies": "node tools/validate-competency-registration.mjs",
    "rewrite:assets": "python tools/rewrite-asset-paths.py",
    "organize:assets": "python tools/organize-artwork.py",
    "validate:asset-paths": "python tools/validate-asset-paths.py",
    "validate:assets": "python tools/validate-asset-paths.py --require-assets",
    "generate:glyphs": "python tools/generate-competency-glyphs.py --repo .",
    "validate:compiled-packs": "node tools/validate-compiled-packs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knightweaver/edgeheart.git"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "rimraf": "^6.0.1"
  }
}
