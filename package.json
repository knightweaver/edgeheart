{
  "name": "edgeheart",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for the Edgeheart Foundry VTT module.",
  "type": "module",
  "scripts": {
    "validate": "node tools/validate-skeleton.mjs",
    "clean:packs": "rimraf packs",
    "compile:packs": "node tools/compile-packs.mjs",
    "extract:packs": "node tools/extract-packs.mjs",
    "build": "npm run validate && npm run clean:packs && npm run compile:packs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knightweaver/edgeheart.git"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "rimraf": "^6.0.1"
  }
}
